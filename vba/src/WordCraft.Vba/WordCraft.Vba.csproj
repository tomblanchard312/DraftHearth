<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The .NET the installed SDK ships (8, 9, 10…): the VB compiler comes from that SDK and is
         built for it, so the target must match (an SDK 10 compiler can't build for .NET 8). -->
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>wcvba</AssemblyName>
    <RootNamespace>WordCraft.Vba</RootNamespace>
  </PropertyGroup>

  <!-- Portable compiler assemblies are required for cross-published runtime bundles. -->
  <ItemGroup Condition="'$(RoslynDir)' == ''">
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(RoslynDir)' != ''">
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(RoslynDir)/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.VisualBasic"><HintPath>$(RoslynDir)/Microsoft.CodeAnalysis.VisualBasic.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WordCraft.ObjectModel\WordCraft.ObjectModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WordCraft.Vba.Tests" />
  </ItemGroup>

</Project>
