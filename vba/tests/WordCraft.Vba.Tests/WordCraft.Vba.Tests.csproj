<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The .NET the installed SDK ships (8, 9, 10…): the VB compiler comes from that SDK and is
         built for it, so the target must match (an SDK 10 compiler can't build for .NET 8). -->
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WordCraft.Vba\WordCraft.Vba.csproj" />
    <ProjectReference Include="..\..\src\WordCraft.ObjectModel\WordCraft.ObjectModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\*.bas" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
